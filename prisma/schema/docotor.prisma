model Doctor {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  adress          String?
  specilization   String
  licenceNumber   String   @unique
  qulaification   String
  experienceYears Int
  bio             String?
  consultatinFee  Decimal? @db.Decimal(10, 2)
  contactNumber   String?

  isDeleted          Boolean                   @default(false)
  deletedAt          DateTime?
  verificationstatus DoctorsVerificationStatus @default(PENDING)

  rejectionReson String?
  revewBy        String?

  resume          String?
  resumePublicId  String?
  additionalFiles Json?
  revewedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  schedules    Schedule[]
  appointments Appointment[]

  @@index([email], name: "idx_doctor_email")
  @@map("Doctors")
}
