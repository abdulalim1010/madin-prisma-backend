<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Email Verification - PH Madin Healthcare</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f4f7fb;
  font-family: Arial, Helvetica, sans-serif;
">

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="padding: 40px 15px;"
  >
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width: 600px;
            width: 100%;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                background-color: #0f766e;
                padding: 30px 20px;
                text-align: center;
              "
            >

              <h1 style="
                margin: 0;
                color: #ffffff;
                font-size: 28px;
                font-weight: 700;
              ">
                PH Madin Healthcare
              </h1>

              <p style="
                margin: 8px 0 0;
                color: #d1fae5;
                font-size: 14px;
              ">
                Your Health, Our Priority
              </p>

            </td>
          </tr>


          <!-- Body -->
          <tr>
            <td style="padding: 40px 35px;">

              <!-- Title -->
              <h2 style="
                margin: 0 0 18px;
                color: #1f2937;
                font-size: 24px;
                font-weight: 700;
              ">
                Verify Your Email Address
              </h2>


              <!-- Greeting -->
              <p style="
                color: #4b5563;
                font-size: 15px;
                line-height: 1.7;
                margin: 0 0 18px;
              ">
                Hello <strong><%= name %></strong>,
              </p>


              <!-- Message -->
              <p style="
                color: #4b5563;
                font-size: 15px;
                line-height: 1.7;
                margin: 0 0 15px;
              ">
                Thank you for registering with
                <strong>PH Madin Healthcare</strong>.
              </p>

              <p style="
                color: #4b5563;
                font-size: 15px;
                line-height: 1.7;
                margin: 0 0 15px;
              ">
                To complete your registration, please verify your
                email address using the verification code below.
              </p>


              <!-- Email -->
              <p style="
                color: #6b7280;
                font-size: 14px;
                line-height: 1.6;
                margin: 0 0 25px;
              ">
                Email:
                <strong style="color: #374151;">
                  <%= email %>
                </strong>
              </p>


              <!-- OTP Box -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="margin: 25px 0;"
              >
                <tr>
                  <td align="center">

                    <div style="
                      display: inline-block;
                      background-color: #ecfdf5;
                      border: 2px dashed #0f766e;
                      border-radius: 10px;
                      padding: 18px 40px;
                    ">

                      <span style="
                        display: block;
                        color: #6b7280;
                        font-size: 12px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        margin-bottom: 8px;
                      ">
                        VERIFICATION CODE
                      </span>

                      <span style="
                        display: block;
                        font-size: 32px;
                        font-weight: bold;
                        letter-spacing: 8px;
                        color: #0f766e;
                      ">
                        <%= otp %>
                      </span>

                    </div>

                  </td>
                </tr>
              </table>


              <!-- Expiration Notice -->
              <div style="
                background-color: #fff7ed;
                border-left: 4px solid #f97316;
                padding: 14px 16px;
                margin: 25px 0;
              ">

                <p style="
                  margin: 0;
                  color: #9a3412;
                  font-size: 14px;
                  line-height: 1.6;
                ">
                  ⚠️ This verification code will expire in
                  <strong>
                    <%= expirationSecond %> minutes
                  </strong>.
                </p>

              </div>


              <!-- Security Message -->
              <p style="
                color: #6b7280;
                font-size: 14px;
                line-height: 1.7;
                margin: 0 0 10px;
              ">
                For your security, please do not share this
                verification code with anyone.
              </p>

              <p style="
                color: #6b7280;
                font-size: 14px;
                line-height: 1.7;
                margin: 0;
              ">
                If you did not request this email verification,
                you can safely ignore this email.
              </p>

            </td>
          </tr>


          <!-- Footer -->
          <tr>
            <td
              style="
                background-color: #f8fafc;
                padding: 25px;
                text-align: center;
                border-top: 1px solid #e5e7eb;
              "
            >

              <p style="
                margin: 0 0 8px;
                color: #374151;
                font-size: 13px;
                font-weight: bold;
              ">
                PH Madin Healthcare
              </p>

              <p style="
                margin: 0 0 8px;
                color: #9ca3af;
                font-size: 12px;
              ">
                This is an automated email. Please do not reply.
              </p>

              <p style="
                margin: 0;
                color: #9ca3af;
                font-size: 12px;
              ">
                © PH Madin Healthcare. All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>